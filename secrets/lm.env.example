# Скопируй в lm.env и подставь свои значения:
#   cp secrets/lm.env.example secrets/lm.env
# Файл lm.env в git не попадает (.gitignore).

LM_HOST=192.168.100.130
LM_FTP_USER=apps
LM_FTP_PASSWORD=
LM_ADMIN_USER=admin
LM_ADMIN_PASSWORD=
# Опционально — respawn Resident после lm-watchdog-update.sh (если нет SSH-ключа):
# LM_SSH_USER=root
# LM_SSH_PASSWORD=
