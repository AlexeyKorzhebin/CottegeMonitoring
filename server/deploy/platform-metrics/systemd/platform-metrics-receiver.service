# Template: review paths, image ID, UID and actual Docker/systemd setup before installing.
[Unit]
Description=Isolated platform metrics receiver
After=docker.service
Requires=docker.service

[Service]
Type=simple
# The env file contains only PLATFORM_METRICS_ENABLED and PLATFORM_METRICS_DB_URL.
# Token directory must be traversable/readable by container UID/GID 65532.
ExecStart=/usr/bin/docker run --rm --name platform-metrics-receiver --network host --cpus 0.5 --memory 256m --pids-limit 64 --read-only --tmpfs /tmp:rw,noexec,nosuid,nodev,size=16m --cap-drop ALL --security-opt no-new-privileges --user 65532:65532 --env-file /etc/platform-metrics/receiver.env --mount type=bind,src=/etc/platform-metrics/writer-secret,dst=/run/secrets/platform-metrics,readonly --env PLATFORM_METRICS_TOKEN_FILE=/run/secrets/platform-metrics/token REPLACE_WITH_REVIEWED_LOCAL_IMAGE_ID
ExecStop=/usr/bin/docker stop --time 10 platform-metrics-receiver
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
