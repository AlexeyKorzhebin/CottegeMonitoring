# Insert this zone in the existing http {} context exactly once.
# Constant key shares one limit across all clients for this one writer.
limit_req_zone $server_name zone=platform_metrics_writer:1m rate=60r/m;

# Place the following locations in the verified elion.black-castle.ru HTTPS server {}.
# Confirm no duplicate exact location or named location before editing.
location = /api/v1/platform-metrics/batches {
    access_log off;
    client_max_body_size 64k;
    client_body_timeout 10s;
    limit_req zone=platform_metrics_writer burst=10 nodelay;
    limit_req_status 429;
    error_page 429 = @platform_metrics_rate_limited;
    proxy_connect_timeout 2s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;
    proxy_pass http://127.0.0.1:8330;
}
location @platform_metrics_rate_limited {
    access_log off;
    add_header Retry-After 1 always;
    return 429;
}
