      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT e.ts AS time, CASE WHEN lower(e.value #>> '{}') IN ('true','t','1') THEN 1 ELSE 0 END AS value\nFROM events e\nWHERE e.house_id = 'house' AND e.ga = '35/1/1'\nORDER BY e.ts DESC\nLIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFF",
                  "color": "semi-dark-red",
                  "index": 0
                },
                "1": {
                  "text": "ON",
                  "color": "semi-dark-green",
                  "index": 1
                }
              }
            }
          ]
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "GA 35/1/1 — MQTT availability GPU-хоста. ON = online."
